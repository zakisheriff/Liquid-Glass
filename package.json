{
  "name": "@zakisheriff/liquid-glass",
  "version": "0.3.4",
  "description": "Real refracting liquid glass UI components for React — iOS 26's Liquid Glass, on the web.",
  "author": "Zaki Sheriff",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "liquid-glass",
    "liquid glass",
    "ios26",
    "react",
    "glass",
    "refraction",
    "glassmorphism",
    "switch",
    "tab-bar",
    "segmented-control",
    "slider",
    "ui",
    "components",
    "apple",
    "zakisheriff"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zakisheriff/Liquid-Glass.git"
  },
  "homepage": "https://liquidglass.theatom.lk",
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/analytics": "^2.0.1",
    "liquid-glass-release": "npm:@zakisheriff/liquid-glass@0.3.4",
    "next": "^16.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "site": "next dev demo",
    "site:build": "next build demo",
    "readme": "node scripts/readme.mjs"
  }
}
